let currentQuestion = 0;
let score = 0;
let firstAttempt = true;
let currentAnswers = [];

function shuffle(array) {
    const arr = [...array];

    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }

    return arr;
}

function startQuiz() {
    document.getElementById("intro").classList.add("hidden");
    document.getElementById("quiz").classList.remove("hidden");

    currentQuestion = 0;
    score = 0;

    showQuestion();
}

function showQuestion() {
    const q = questions[currentQuestion];

    firstAttempt = true;

    document.getElementById("questionNumber").textContent =
        `Questão ${currentQuestion + 1} de ${questions.length}`;

    document.getElementById("scoreText").textContent =
        `Pontuação: ${score}`;

    document.getElementById("progressFill").style.width =
        `${(currentQuestion / questions.length) * 100}%`;

    document.getElementById("category").textContent = q.category;
    document.getElementById("questionTitle").textContent = q.title;
    document.getElementById("questionText").textContent = q.text;

    document.getElementById("feedback").textContent = "";
    document.getElementById("nextButton").classList.add("hidden");

    currentAnswers = q.answers.map((answer, index) => ({
        text: answer,
        correct: index === q.correct
    }));

    currentAnswers = shuffle(currentAnswers);

    renderAnswers();
}

function renderAnswers() {
    const answerContainer = document.getElementById("answers");
    answerContainer.innerHTML = "";

    currentAnswers.forEach((answer, index) => {
        const button = document.createElement("button");
        button.className = "answer";

        button.textContent =
            String.fromCharCode(65 + index) + ") " + answer.text;

        button.onclick = () => selectAnswer(button, answer);

        answerContainer.appendChild(button);
    });
}

function selectAnswer(button, answer) {
    if (answer.correct) {
        button.classList.add("correct");

        if (firstAttempt) {
            score++;
        }

        document.getElementById("feedback").textContent =
            firstAttempt
            ? "Resposta correta! O Ministério do Caos reconhece sua competência."
            : "Finalmente. O sistema educacional agradece.";

        document.getElementById("scoreText").textContent =
            `Pontuação: ${score}`;

        document.querySelectorAll(".answer").forEach(btn => {
            btn.disabled = true;
            btn.style.pointerEvents = "none";
        });

        document.getElementById("nextButton").classList.remove("hidden");

    } else {
        button.classList.add("wrong");
        button.disabled = true;
        firstAttempt = false;

        document.getElementById("feedback").textContent =
            "Alternativa incorreta. Eliminada. Tente novamente, candidata.";
    }
}

function nextQuestion() {
    currentQuestion++;

    if (currentQuestion < questions.length) {
        showQuestion();
    } else {
        finishQuiz();
    }
}

function finishQuiz() {
    document.getElementById("quiz").classList.add("hidden");
    document.getElementById("result").classList.remove("hidden");

    document.getElementById("progressFill").style.width = "100%";

    const percentage = Math.round((score / questions.length) * 100);

    document.getElementById("finalScore").textContent =
        `${score} / ${questions.length} (${percentage}%)`;

    let message = "";
    let finalText = "";

    if (score === 16) {
        message = "ABSURDAMENTE PERFEITO.";
        finalText = `Você conseguiu uma pontuação perfeita.
O Conselho dos Hansels está em choque, Arqui Hansel está revisando
os dados e o Imperador provavelmente está tentando atribuir
o mérito a si mesmo.

Não há evidências de fraude. Por enquanto.`;

    } else if (score >= 13) {
        message = "APROVADA COM HONRAS DO CAOS.";
        finalText = `Um resultado impressionante.
Você demonstrou conhecimentos acima da média sobre acontecimentos,
personagens, referências e informações que nenhuma instituição
deveria exigir de uma pessoa.

O Ministério do Caos considera sua aprovação.`;

    } else if (score >= 9) {
        message = "SOBREVIVEU AO PROCESSO SELETIVO.";
        finalText = `Seu desempenho foi satisfatório.
Algumas informações ainda estão incompletas, mas você demonstrou
capacidade de interpretação e resistência ao sistema.

Recomenda-se estudar o Hansel antes da próxima avaliação.`;

    } else if (score >= 5) {
        message = "RECUPERAÇÃO SENTIMENTAL.";
        finalText = `A banca identificou potencial, mas também uma quantidade
preocupante de lacunas no conhecimento.

Recomenda-se revisão do conteúdo, leitura complementar
e talvez uma reunião com o próprio elaborador da prova,
que claramente precisa parar de inventar questões.`;

    } else {
        message = "O MINISTÉRIO DO CAOS SOLICITOU UMA REAVALIAÇÃO.";
        finalText = `A pontuação foi considerada insuficiente para comprovar
domínio dos conteúdos absurdamente específicos.

Entretanto, a instituição reconhece que a prova foi elaborada
por uma pessoa que provavelmente transformaria até uma pergunta
sobre o horário em um debate filosófico de três horas.

Você está oficialmente autorizada a tentar novamente.`;
    }

    document.getElementById("resultMessage").textContent = message;
    document.getElementById("finalText").textContent = finalText;
}
</script>

